Print[ OutputForm["Import and test Geomtry.wl"] ];

Get[
    FileNameJoin[
        {NotebookDirectory[], "..", "wolfram", "Geometry.wl"}
    ]
];

Vpuc[1, 0, 0]
(* expected: Sqrt[3]/2 *)

FullSimplify[
    ee[\[Eta], \[CurlyPhi], \[Alpha]R] . Transpose[EE[\[Eta], \[CurlyPhi], \[Alpha]R]]
]
(* expected: IdentityMatrix[3] *)

Print[ OutputForm["Import and test FourierBasis.wl"] ];

Get[
    FileNameJoin[
        {NotebookDirectory[], "..", "wolfram", "FourierBasis.wl"}
    ]
];

Print[ OutputForm["-> Configure a 6-fold magnetic lattice"] ];

ConfigureFourierBasis[2, "SixFold"];
(* corresponding to NN=2 and a reduced six-fold symmetric example *)

M[1, 0]//MatrixForm
M[-1, 0]//MatrixForm
M[0, 0]//MatrixForm

independentNodes[2]

Length[MagneticVariables[2, "SixFold"]]

Print[ OutputForm["-> Configure a general magnetic and lattice"] ];

ConfigureFourierBasis[2, "General"];
(* corresponding to NN=2 and a reduced six-fold symmetric example *)

M[1, 0]//MatrixForm
M[-1, 0]//MatrixForm
M[0, 0]//MatrixForm
U[1, 0]//MatrixForm
U[-1, 0]//MatrixForm
U[0, 0]//MatrixForm

independentNodes[2]

Length[MagneticVariables[2, "General"]]

Print[ OutputForm["-> Test the magnetic energy functions for the hexagonal SkL"] ];

Get[
    FileNameJoin[
        {NotebookDirectory[], "..", "wolfram", "EnergyMagnetic.wl"}
    ]
];

ConfigureFourierBasis[1, "SixFold"];

Print[ OutputForm["Exchange energy :"] ];
ExchangeEnergy[a, eta, phi, alphaR]
Print[ OutputForm["Bloch DMI energy :"] ];
BlochDMIEnergy[a, eta, phi, alphaR]
Print[ OutputForm["Zeeman energy :"] ];
ZeemanEnergy[b]

Nij = DiagonalMatrix[{1 / 3, 1 / 3, 1 / 3}];

Print[ OutputForm["Dipolar energy :"] ];
MagnetostaticInfiniteEnergy[
    xi,
    Nij,
    eta,
    phi,
    alphaR
]

Print[ OutputForm["Constraint energy :"] ];
ConstraintEnergy[
    lambda,
    eta,
    phi,
    alphaR
]

Print[ OutputForm["-> Test BuildEnergy.wl"] ];

Get[
    FileNameJoin[
        {NotebookDirectory[], "..", "wolfram", "BuildEnergy.wl"}
    ]
];

emag = BuildMagneticEnergy[1, "Bloch"];

emag = BuildMagneticEnergy[1, "Bloch"];

Print[ OutputForm["-> Test minimisation routing in GroundState.wl"] ];

Get[
    FileNameJoin[
        {NotebookDirectory[], "..", "wolfram", "GroundState.wl"}
    ]
];

emag =
    BuildMagneticEnergy[
        2,
        "Bloch"
    ];

parameterRules = {
    b -> 0.5,
    xi -> 0.88,
    lambda -> 500,

    Nx -> 1 / 3,
    Ny -> 1 / 3,
    Nz -> 1 / 3,

    alphaR0 -> 0
};

initialValues = {

    (* n = (-1,1) *)
    {muI[1, -1, 1],  0.029},
    {muI[2, -1, 1],  0.029},
    {muR[3, -1, 1], -0.034},

    (* n = (0,1) *)
    {muI[1, 0, 1], -0.310},
    {muI[2, 0, 1], -0.155},
    {muR[3, 0, 1],  0.265},

    (* n = (0,2) *)
    {muI[1, 0, 2],  0.0055},
    {muI[2, 0, 2],  0.0028},
    {muR[3, 0, 2], -0.0043},

    (* n = (1,1) *)
    {muI[1, 1, 1],  0.126},
    {muI[2, 1, 1], -0.137},
    {muR[3, 1, 1], -0.216},

    (* n = (1,2) *)
    {muI[1, 1, 2], -0.029},
    {muI[2, 1, 2], -0.0003},
    {muR[3, 1, 2],  0.034},

    (* n = (2,1) *)
    {muI[1, 2, 1],  0.0},
    {muI[2, 2, 1], -0.030},
    {muR[3, 2, 1], -0.015},

    (* n = (2,2) *)
    {muI[1, 2, 2], -0.015},
    {muI[2, 2, 2], -0.0006},
    {muR[3, 2, 2],  0.017},

    (* Uniform component *)
    {muR[3, 0, 0], 0.44},

    (* n = (1,0) *)
    {muI[1, 1, 0], 0.126},
    {muI[2, 1, 0], 0.263},
    {muR[3, 1, 0], 0.216},

    (* n = (2,0) *)
    {muI[1, 2, 0], 0.015},
    {muI[2, 2, 0], 0.014},
    {muR[3, 2, 0], 0.017},

    (* Lattice parameters *)
    {a0,   7.5},
    {eta0, 1.0},
    {phi0, 0.0}
};

result =
    FindMagneticEquilibrium[
        emag,
        parameterRules,
        initialValues
    ];

Print[ OutputForm["Minimisation finished!! The energy is :"] ];

result[[1]]

SaveMagneticEquilibrium[
    result,
    parameterRules,
    "Bloch"
];

Print[ OutputForm["Configuration saved!"] ];

Print[ OutputForm["-> Now  let's plot the solution with Plotting.wl"] ];

Get[
    FileNameJoin[
        {NotebookDirectory[], "..", "wolfram", "Plotting.wl"}
    ]
];

gsRules =
    Join[
        result[[2]],
        parameterRules
    ];

SkyrmionConfigurationPlot[
    gsRules
]

SkyrmionConfigurationPlot[
     gsRules,
    ShowFrameAndLabels -> False,
    ImageSize -> 300,
    Range -> 3
 ]

Print[ OutputForm["-> Test loading functionality inside GroundState.wl"] ];

 saved =
    LoadMagneticEquilibrium[
        "Bloch_N2_b0.5_xi0.88_Nz0.333333.txt"
    ];

Print[ OutputForm["The configuration was succesfully loaded!"] ];