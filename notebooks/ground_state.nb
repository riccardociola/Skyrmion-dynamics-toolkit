In[1]:= Get[FileNameJoin[{NotebookDirectory[], "..", "wolfram", "Geometry.wl"}]];
Get[FileNameJoin[{NotebookDirectory[], "..", "wolfram", "FourierBasis.wl"}]];
Get[FileNameJoin[{NotebookDirectory[], "..", "wolfram", "EnergyMagnetic.wl"}]];
Get[FileNameJoin[{NotebookDirectory[], "..", "wolfram", "BuildEnergy.wl"}]];
