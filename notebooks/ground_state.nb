    FileNameJoin[
        {NotebookDirectory[], "..", "wolfram", "FourierBasis.wl"}
    ]
];

Print[ OutputForm["-> Configure a 6-fold magnetic lattice"] ];

ConfigureFourierBasis[2, "SixFold"];
(* corresponding to NN=2 and a reduced six-fold symmetric example *)

M[1, 0]//MatrixForm
M[-1, 0]//MatrixForm
M[0, 0]//MatrixForm

independentNodes[2]

Length[MagneticVariables[2, "SixFold"]]

