M[1, 0]//MatrixForm
M[-1, 0]//MatrixForm
M[0, 0]//MatrixForm
U[1, 0]//MatrixForm
U[-1, 0]//MatrixForm
U[0, 0]//MatrixForm

independentNodes[2]

